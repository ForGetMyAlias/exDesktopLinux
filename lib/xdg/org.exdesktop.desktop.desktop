[Desktop Entry]
Name=exDesktop
Comment=New era of messaging
TryExec=exDesktop
Exec=exDesktop -- %U
Icon=org.exdesktop.desktop
Terminal=false
StartupWMClass=exDesktop
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
Keywords=exdesktop;extera;tg;chat;im;messaging;messenger;sms;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=exDesktop -quit
Name=Quit exDesktop
Icon=application-exit
